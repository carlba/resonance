NODE_ENV="development"
PORT=3000
LOG_LEVEL="debug"
# Base URL of the slskd instance and an API key from its config (web.authentication.api_keys).
SLSKD_URL="http://localhost:5030"
SLSKD_API_KEY=""
# Deleting downloads needs remote file management on in slskd itself, not here: set
# SLSKD_REMOTE_FILE_MANAGEMENT=true (or `remote_file_management: true`) in slskd's environment or
# config. The backend reads the setting from slskd and has nothing to configure.
# How long GET /tracks waits for an slskd search before returning what it has (milliseconds).
SEARCH_TIMEOUT_MS=30000
# How often the frontend reads the download statuses from the backend (milliseconds, minimum 250).
# Used by the Downloads page and the result cards. Read by Vite, hence the VITE_ prefix.
VITE_DOWNLOADS_POLL_INTERVAL_MS=2000
