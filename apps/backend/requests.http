# Requests for the backend. @baseUrl uses the default PORT (3000) from src/config/env.schema.ts;
# change it here if the root .env sets another port.
@baseUrl = http://localhost:3000

### Greeting (200)
GET {{baseUrl}}/

### Unknown route (404, via the global exception filter)
GET {{baseUrl}}/does-not-exist

### Search tracks through slskd (200; 502 if slskd is unreachable, 504 on a timeout without results)
GET {{baseUrl}}/tracks?q=daft punk around the world

### Search tracks without a query (400)
GET {{baseUrl}}/tracks

### Search tracks with an empty query (400)
GET {{baseUrl}}/tracks?q="Thomas Rusiak - Magic Villa"

### Search tracks with an unknown query parameter (400)
GET {{baseUrl}}/tracks?q=daft punk&page=2

### Search albums through slskd (200; 502 if slskd is unreachable, 504 on a timeout without results)
GET {{baseUrl}}/albums?q=daft punk discovery

### Search albums without a query (400)
GET {{baseUrl}}/albums

### Search albums with an empty query (400)
GET {{baseUrl}}/albums?q=

### Download an album folder, every file of it, from a user (201; 502 if slskd is unreachable or rejects files)
POST {{baseUrl}}/downloads
Content-Type: application/json

{
  "username": "alice",
  "files": [
    { "path": "Music\\Daft Punk - Discovery (2001)\\01 - One More Time.flac", "size": 38000000 },
    { "path": "Music\\Daft Punk - Discovery (2001)\\cover.jpg", "size": 200000 }
  ]
}

### Download a single track (201)
POST {{baseUrl}}/downloads
Content-Type: application/json

{
  "username": "alice",
  "files": [{ "path": "Music\\Daft Punk - Discovery (2001)\\01 - One More Time.flac", "size": 38000000 }]
}

### Download without files (400)
POST {{baseUrl}}/downloads
Content-Type: application/json

{ "username": "alice", "files": [] }

### Download with an unknown property (400)
POST {{baseUrl}}/downloads
Content-Type: application/json

{ "username": "alice", "files": [{ "path": "a.flac", "size": 1 }], "destination": "/tmp" }

### List every download slskd knows about, grouped by user and folder (200; 502 if slskd is unreachable)
GET {{baseUrl}}/downloads
